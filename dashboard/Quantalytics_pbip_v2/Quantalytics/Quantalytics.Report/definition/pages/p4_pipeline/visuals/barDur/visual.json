              "nativeQueryRef": "Stage",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_pipeline_run"
                    }
                  },
                  "Property": "Avg Run Duration (s)"
                }
              },
              "queryRef": "fact_pipeline_run.Avg Run Duration (s)",
              "nativeQueryRef": "Avg Run Duration (s)"
            }
          ]
