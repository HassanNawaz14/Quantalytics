		summarizeBy: sum
		sourceColumn: t2_us

		annotation SummarizationSetBy = Automatic

	column 'Readout Error'
		dataType: double
		formatString: 0.00%
		lineageTag: 30e237b6-d2a3-471b-9d79-d51ad99a3e99
		summarizeBy: sum
		sourceColumn: readout_error

		annotation SummarizationSetBy = Automatic

	column 'Init Error'
		dataType: double
