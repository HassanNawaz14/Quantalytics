		summarizeBy: sum
		sourceColumn: init_error

		annotation SummarizationSetBy = Automatic

	column Operational
		dataType: boolean
		lineageTag: f8d3a1fd-376b-490c-bbae-72fc4d448324
		summarizeBy: none
		sourceColumn: operational

	column source_file
		dataType: string
		isHidden
		lineageTag: 5d8bb795-6876-4745-9fb1-101448ab4dac
		summarizeBy: none
		sourceColumn: source_file

	column 'Silver Load Time'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: e8908b78-1834-4c36-955a-74a82c9034b4
		summarizeBy: none
		sourceColumn: silver_load_timestamp

		variation Variation
			isDefault
			relationship: 967a5641-87bc-47c5-8298-b889af935e4b
			defaultHierarchy: LocalDateTable_43e0057c-c4a3-4822-a23f-fe964e4e34cf.'Date Hierarchy'

	column 'T1 Bucket (µs)' = IF ( ISBLANK ( fact_qubit_calibration[T1 (µs)] ), BLANK (), FLOOR ( fact_qubit_calibration[T1 (µs)], 50 ) )
		dataType: double
		formatString: #,0
		lineageTag: 3293fa86-7732-4d36-94db-233a1dd3aaf1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'T2/T1 Ratio Bucket' = IF ( OR ( ISBLANK ( fact_qubit_calibration[T1 (µs)] ), ISBLANK ( fact_qubit_calibration[T2 (µs)] ), fact_qubit_calibration[T1 (µs)] <= 0 ), BLANK (), ROUND ( DIVIDE ( fact_qubit_calibration[T2 (µs)], fact_qubit_calibration[T1 (µs)] ) * 4, 0 ) / 4 )
		dataType: double
		formatString: 0.00
		lineageTag: b7ab3cfc-3902-4122-8081-7bf2eb40897a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition fact_qubit_calibration = m
		mode: import
		source =
				let
					Source = Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
					Cat = Source{[Name = DatabricksCatalog, Kind = "Database"]}[Data],
					Sch = Cat{[Name = DatabricksSchema, Kind = "Schema"]}[Data],
					Tbl = Sch{[Name = "fact_qubit_calibration", Kind = "Table"]}[Data]
				in
