	measure 'Corr T1 vs F10.7' = VAR tbl = FILTER ( fact_backend_daily, NOT ISBLANK ( fact_backend_daily[avg_t1_us] ) && NOT ISBLANK ( fact_backend_daily[avg_f107_solar_flux] ) ) VAR n = COUNTROWS ( tbl ) VAR sx = SUMX ( tbl, fact_backend_daily[avg_f107_solar_flux] ) VAR sy = SUMX ( tbl, fact_backend_daily[avg_t1_us] ) VAR sxy = SUMX ( tbl, fact_backend_daily[avg_f107_solar_flux] * fact_backend_daily[avg_t1_us] ) VAR sxx = SUMX ( tbl, fact_backend_daily[avg_f107_solar_flux] ^ 2 ) VAR syy = SUMX ( tbl, fact_backend_daily[avg_t1_us] ^ 2 ) VAR den = SQRT ( ( n * sxx - sx ^ 2 ) * ( n * syy - sy ^ 2 ) ) RETURN IF ( n >= 5 && den > 0, DIVIDE ( n * sxy - sx * sy, den ) )
		formatString: 0.00
