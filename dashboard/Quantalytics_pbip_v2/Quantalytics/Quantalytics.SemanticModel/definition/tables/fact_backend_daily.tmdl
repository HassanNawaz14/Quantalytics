	measure 'Strongest T1~Kp Lag (days)' = IF ( ISBLANK ( [Strongest T1~Kp r] ), BLANK (), SWITCH ( TRUE (), ABS ( [r T1 vs Kp · lag 0d] ) = [Strongest T1~Kp r], 0, ABS ( [r T1 vs Kp · lag 1d] ) = [Strongest T1~Kp r], 1, ABS ( [r T1 vs Kp · lag 2d] ) = [Strongest T1~Kp r], 2, ABS ( [r T1 vs Kp · lag 3d] ) = [Strongest T1~Kp r], 3, ABS ( [r T1 vs Kp · lag 5d] ) = [Strongest T1~Kp r], 5, ABS ( [r T1 vs Kp · lag 7d] ) = [Strongest T1~Kp r], 7 ) )
		formatString: 0
