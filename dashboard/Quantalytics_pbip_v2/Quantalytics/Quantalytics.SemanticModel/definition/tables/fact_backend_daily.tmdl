	measure 'Corr T1 vs Kp' = VAR tbl = FILTER ( fact_backend_daily, NOT ISBLANK ( fact_backend_daily[avg_t1_us] ) && NOT ISBLANK ( fact_backend_daily[avg_kp] ) ) VAR n = COUNTROWS ( tbl ) VAR sx = SUMX ( tbl, fact_backend_daily[avg_kp] ) VAR sy = SUMX ( tbl, fact_backend_daily[avg_t1_us] ) VAR sxy = SUMX ( tbl, fact_backend_daily[avg_kp] * fact_backend_daily[avg_t1_us] ) VAR sxx = SUMX ( tbl, fact_backend_daily[avg_kp] ^ 2 ) VAR syy = SUMX ( tbl, fact_backend_daily[avg_t1_us] ^ 2 ) VAR den = SQRT ( ( n * sxx - sx ^ 2 ) * ( n * syy - sy ^ 2 ) ) RETURN IF ( n >= 5 && den > 0, DIVIDE ( n * sxy - sx * sy, den ) )
		formatString: 0.00
		displayFolder: Correlation
		lineageTag: 1b377519-1b09-4324-b31b-43ffe813426d

	measure 'Corr T2 vs Kp' = VAR tbl = FILTER ( fact_backend_daily, NOT ISBLANK ( fact_backend_daily[avg_t2_us] ) && NOT ISBLANK ( fact_backend_daily[avg_kp] ) ) VAR n = COUNTROWS ( tbl ) VAR sx = SUMX ( tbl, fact_backend_daily[avg_kp] ) VAR sy = SUMX ( tbl, fact_backend_daily[avg_t2_us] ) VAR sxy = SUMX ( tbl, fact_backend_daily[avg_kp] * fact_backend_daily[avg_t2_us] ) VAR sxx = SUMX ( tbl, fact_backend_daily[avg_kp] ^ 2 ) VAR syy = SUMX ( tbl, fact_backend_daily[avg_t2_us] ^ 2 ) VAR den = SQRT ( ( n * sxx - sx ^ 2 ) * ( n * syy - sy ^ 2 ) ) RETURN IF ( n >= 5 && den > 0, DIVIDE ( n * sxy - sx * sy, den ) )
		formatString: 0.00
		displayFolder: Correlation
		lineageTag: f4c46a7e-422d-4976-aac3-d85374411acc

	measure 'Corr Readout Error vs Kp' = VAR tbl = FILTER ( fact_backend_daily, NOT ISBLANK ( fact_backend_daily[avg_readout_error] ) && NOT ISBLANK ( fact_backend_daily[avg_kp] ) ) VAR n = COUNTROWS ( tbl ) VAR sx = SUMX ( tbl, fact_backend_daily[avg_kp] ) VAR sy = SUMX ( tbl, fact_backend_daily[avg_readout_error] ) VAR sxy = SUMX ( tbl, fact_backend_daily[avg_kp] * fact_backend_daily[avg_readout_error] ) VAR sxx = SUMX ( tbl, fact_backend_daily[avg_kp] ^ 2 ) VAR syy = SUMX ( tbl, fact_backend_daily[avg_readout_error] ^ 2 ) VAR den = SQRT ( ( n * sxx - sx ^ 2 ) * ( n * syy - sy ^ 2 ) ) RETURN IF ( n >= 5 && den > 0, DIVIDE ( n * sxy - sx * sy, den ) )
