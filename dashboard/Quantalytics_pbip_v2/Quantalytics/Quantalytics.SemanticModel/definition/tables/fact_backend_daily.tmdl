	measure 'Correlation Strength' = VAR r = ABS ( [Corr T1 vs Kp] ) RETURN SWITCH ( TRUE (), ISBLANK ( r ), "n/a", r < 0.2, "Negligible", r < 0.4, "Weak", r < 0.6, "Moderate", "Strong" )
		displayFolder: Correlation
		lineageTag: 697f8c9b-5d3a-41b8-9feb-510cbac4c5c4

