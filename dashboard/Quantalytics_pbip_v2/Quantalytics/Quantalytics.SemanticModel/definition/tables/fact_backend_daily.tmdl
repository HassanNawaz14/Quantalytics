	measure 'r Readout vs Kp · lag 0d' = VAR tbl = ADDCOLUMNS ( FILTER ( VALUES ( dim_date[Date] ), NOT ISBLANK ( [Avg Kp (lag 0d)] ) && NOT ISBLANK ( [Daily Avg Readout Error] ) ), "@x", [Avg Kp (lag 0d)], "@y", [Daily Avg Readout Error] ) VAR n = COUNTROWS ( tbl ) VAR sx = SUMX ( tbl, [@x] ) VAR sy = SUMX ( tbl, [@y] ) VAR sxy = SUMX ( tbl, [@x] * [@y] ) VAR sxx = SUMX ( tbl, [@x] ^ 2 ) VAR syy = SUMX ( tbl, [@y] ^ 2 ) VAR den = SQRT ( ( n * sxx - sx ^ 2 ) * ( n * syy - sy ^ 2 ) ) RETURN IF ( n >= 5 && den > 0, DIVIDE ( n * sxy - sx * sy, den ) )
		formatString: 0.00
		displayFolder: Lag Correlation
		lineageTag: 4e3ee204-aa88-4a0f-8583-94cdf10c2231

