	measure 'T1 Storm Days (µs)' = CALCULATE ( [Daily Avg T1 (µs)], fact_backend_daily[Kp Band] = "Storm (Kp ≥ 5)" )
		formatString: #,0.0
		displayFolder: Storm vs Quiet
		lineageTag: 8f40b6de-e60e-4dba-b8f1-42eb664e2c69

	measure 'T1 Quiet Days (µs)' = CALCULATE ( [Daily Avg T1 (µs)], fact_backend_daily[Kp Band] = "Quiet (Kp < 3)" )
		formatString: #,0.0
		displayFolder: Storm vs Quiet
		lineageTag: 17a04d33-3e70-4158-8061-0fb9c44fff47

	measure 'T1 Storm Impact %' = DIVIDE ( [T1 Storm Days (µs)] - [T1 Quiet Days (µs)], [T1 Quiet Days (µs)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Storm vs Quiet
		lineageTag: 42ae5315-3236-4bd1-ac4c-fd3b5c91d224

	measure 'T2 Storm Impact %' = DIVIDE ( CALCULATE ( [Daily Avg T2 (µs)], fact_backend_daily[Kp Band] = "Storm (Kp ≥ 5)" ) - CALCULATE ( [Daily Avg T2 (µs)], fact_backend_daily[Kp Band] = "Quiet (Kp < 3)" ), CALCULATE ( [Daily Avg T2 (µs)], fact_backend_daily[Kp Band] = "Quiet (Kp < 3)" ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Storm vs Quiet
		lineageTag: 60d80397-1dcf-42a0-bb86-4529dbe94380

	measure 'Readout Storm Impact %' = DIVIDE ( CALCULATE ( [Daily Avg Readout Error], fact_backend_daily[Kp Band] = "Storm (Kp ≥ 5)" ) - CALCULATE ( [Daily Avg Readout Error], fact_backend_daily[Kp Band] = "Quiet (Kp < 3)" ), CALCULATE ( [Daily Avg Readout Error], fact_backend_daily[Kp Band] = "Quiet (Kp < 3)" ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Storm vs Quiet
		lineageTag: 1567feeb-01b0-42dc-a54f-d84189b4402d

	measure 'Most Storm-Sensitive Backend' = VAR t = ADDCOLUMNS ( VALUES ( dim_backend[Backend] ), "@s", ABS ( [T1 Storm Impact %] ) ) RETURN MAXX ( TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@s] ) ), [@s], DESC ), dim_backend[Backend] )
		displayFolder: Insights
		lineageTag: b93baac4-1b31-4123-bbc9-a985f159a991

	measure 'T1 Δ Day -3' = VAR s = FILTER ( VALUES ( dim_date[Date] ), CALCULATE ( MAX ( fact_environment[Kp Index] ) ) >= 5 ) VAR shifted = SELECTCOLUMNS ( s, "d", dim_date[Date] + (-3) ) VAR v = CALCULATE ( [Daily Avg T1 (µs)], TREATAS ( shifted, dim_date[Date] ) ) VAR base = CALCULATE ( [Daily Avg T1 (µs)], ALLSELECTED ( dim_date ) ) RETURN IF ( ISBLANK ( v ), BLANK (), DIVIDE ( v, base ) - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Event Study
		lineageTag: 765dda51-0f06-4590-8bb3-94ef01c6588b

