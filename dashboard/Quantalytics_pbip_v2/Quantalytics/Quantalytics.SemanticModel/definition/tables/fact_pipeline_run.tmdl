table fact_pipeline_run
	lineageTag: ef47b92d-f4be-4214-b5d4-c13ca5837132

	measure 'Pipeline Runs' = COUNTROWS ( fact_pipeline_run )
		formatString: #,0
		displayFolder: Runs
		lineageTag: 74e33d73-ae70-4cf9-855f-e96b62e9662a

	measure 'Successful Runs' = CALCULATE ( COUNTROWS ( fact_pipeline_run ), dim_status[Status] = "SUCCESS" )
		formatString: #,0
		displayFolder: Runs
		lineageTag: f27a01b2-ce97-48cb-ace1-ca743143c65c

	measure 'Failed Runs' = CALCULATE ( COUNTROWS ( fact_pipeline_run ), dim_status[Status] = "FAILURE" )
		formatString: #,0
		displayFolder: Runs
		lineageTag: e8ba9870-d9dc-4cfd-bbed-e246ef52209c

	measure 'Pipeline Success %' = DIVIDE ( [Successful Runs], [Pipeline Runs] )
		formatString: 0.0%
		displayFolder: Runs
		lineageTag: 5041b3b7-17ee-4a87-9b48-6b8804efc075

	measure 'Avg Run Duration (s)' = AVERAGE ( fact_pipeline_run[Run Duration (s)] )
		formatString: #,0.0
		displayFolder: Performance
		lineageTag: ac586e1e-f41b-42c8-bc6d-75bf24ffa7ab

	measure 'Total Input Rows' = SUM ( fact_pipeline_run[Input Rows] )
		formatString: #,0
		displayFolder: Performance
		lineageTag: a080503b-8d38-4a07-93e4-0a4a768148f5

	measure 'Total Rows Inserted' = SUM ( fact_pipeline_run[Rows Inserted] )
		formatString: #,0
		displayFolder: Performance
		lineageTag: 3818e7dd-f7fb-4907-8476-9f5d9fa0eaa2

	measure 'Total Rows Updated' = SUM ( fact_pipeline_run[Rows Updated] )
		formatString: #,0
		displayFolder: Performance
		lineageTag: e8024792-759a-4db5-bee0-d8f543b97672

	measure 'Throughput (rows/s)' = DIVIDE ( SUM ( fact_pipeline_run[Input Rows] ), SUM ( fact_pipeline_run[Run Duration (s)] ) )
		formatString: #,0.0
		displayFolder: Performance
		lineageTag: 8ddcd36f-cb56-440a-ac1c-3e574a1fe73e

	measure 'Last Run Finished' = MAX ( fact_pipeline_run[Finished At] )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Freshness
		lineageTag: 7af7b5ad-75fe-4dd2-950a-08b5476e8500

	measure 'Last Failure' = CALCULATE ( MAX ( fact_pipeline_run[Finished At] ), dim_status[Status] = "FAILURE" )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Freshness
		lineageTag: 170c631a-ad57-409a-b6e0-09684e875a93

