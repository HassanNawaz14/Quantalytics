table fact_quarantine
	lineageTag: fc3c714b-60c5-4a60-8301-a9bdc483c626

	measure 'Quarantined Rows' = COUNTROWS ( fact_quarantine )
		formatString: #,0
		displayFolder: Quarantine
		lineageTag: 0ae33a80-e18d-48b2-ad3f-cb0dbf0adf83

	measure 'Cumulative Quarantine %' = VAR cur = [Quarantined Rows] VAR reasons = ALLSELECTED ( dim_error_reason[Error Reason] ) VAR cumul = SUMX ( FILTER ( reasons, [Quarantined Rows] >= cur ), [Quarantined Rows] ) RETURN DIVIDE ( cumul, CALCULATE ( [Quarantined Rows], ALLSELECTED ( dim_error_reason ) ) )
		formatString: 0%
		displayFolder: Quarantine
		lineageTag: 5c6c2e7d-769f-4ab5-91a6-1adf4cc0cd46

	column quarantine_key
		dataType: string
		isHidden
		lineageTag: 511c7bb2-1bb9-4198-a4c2-c5b9b89386db
		summarizeBy: none
		sourceColumn: quarantine_key

	column date_key
