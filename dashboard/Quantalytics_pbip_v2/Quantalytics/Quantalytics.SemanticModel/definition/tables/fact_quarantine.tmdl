		summarizeBy: none
		sourceColumn: source_file

	column 'Quarantined At'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 9be858e2-2559-40ed-a69e-62f27dd4da0a
		summarizeBy: none
		sourceColumn: quarantined_at

		variation Variation
			isDefault
