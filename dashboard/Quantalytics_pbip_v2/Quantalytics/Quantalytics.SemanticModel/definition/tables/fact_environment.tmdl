table fact_environment
	lineageTag: 8104e37c-533b-42be-8950-f2b403a4c3dc

	measure 'Avg Kp' = AVERAGE ( fact_environment[Kp Index] )
		formatString: 0.00
		displayFolder: Space Weather
		lineageTag: 2bd3e1de-259c-479b-a246-26eaf9f83221

	measure 'Max Kp' = MAX ( fact_environment[Kp Index] )
		formatString: 0.00
		displayFolder: Space Weather
		lineageTag: 7bacb462-199b-4691-a9ee-ba75ad55350f

	measure 'Avg F10.7 (sfu)' = AVERAGE ( fact_environment[F10.7 Flux (sfu)] )
		formatString: #,0.0
		displayFolder: Space Weather
		lineageTag: f2455919-d143-4dd7-b2a9-090b3f11b8cd

	measure 'Days with Kp ≥ 5' = COUNTROWS ( FILTER ( VALUES ( dim_date[Date] ), CALCULATE ( MAX ( fact_environment[Kp Index] ) ) >= 5 ) )
		formatString: #,0
		displayFolder: Space Weather
		lineageTag: cd4e7860-06e4-46ea-b84f-7e23c1c7cd6a

	measure 'Max F10.7 (sfu)' = MAX ( fact_environment[F10.7 Flux (sfu)] )
		formatString: #,0.0
		displayFolder: Space Weather
		lineageTag: 85a9c57f-2db4-4fcf-915a-12c6d55200c9

	measure 'Quiet Days (Kp < 3)' = COUNTROWS ( FILTER ( VALUES ( dim_date[Date] ), NOT ISBLANK ( CALCULATE ( MAX ( fact_environment[Kp Index] ) ) ) && CALCULATE ( MAX ( fact_environment[Kp Index] ) ) < 5 && CALCULATE ( MAX ( fact_environment[Kp Index] ) ) < 3 ) )
		formatString: #,0
		displayFolder: Space Weather
		lineageTag: 2c001bdb-d3a0-4a35-a120-7ae4af054c07

	measure 'Avg Kp (lag 0d)' = VAR d = MAX ( dim_date[Date] ) RETURN CALCULATE ( [Avg Kp], FILTER ( ALL ( dim_date ), dim_date[Date] = d - 0 ) )
		formatString: 0.00
		displayFolder: Lagged Kp
		lineageTag: 22a361ba-9cb8-4cc2-968b-7d21ae77463c

	measure 'Avg Kp (lag 1d)' = VAR d = MAX ( dim_date[Date] ) RETURN CALCULATE ( [Avg Kp], FILTER ( ALL ( dim_date ), dim_date[Date] = d - 1 ) )
		formatString: 0.00
		displayFolder: Lagged Kp
		lineageTag: a853c2fe-d7d3-4ff4-8c6c-1dd1740f9d42

	measure 'Avg Kp (lag 2d)' = VAR d = MAX ( dim_date[Date] ) RETURN CALCULATE ( [Avg Kp], FILTER ( ALL ( dim_date ), dim_date[Date] = d - 2 ) )
		formatString: 0.00
		displayFolder: Lagged Kp
		lineageTag: 2d9bee53-e92b-4463-80d5-95cf6ed86c50

	measure 'Avg Kp (lag 3d)' = VAR d = MAX ( dim_date[Date] ) RETURN CALCULATE ( [Avg Kp], FILTER ( ALL ( dim_date ), dim_date[Date] = d - 3 ) )
		formatString: 0.00
		displayFolder: Lagged Kp
		lineageTag: 7efda0bf-0fbf-412d-8cb4-1cb3b26d81d2

	measure 'Avg Kp (lag 5d)' = VAR d = MAX ( dim_date[Date] ) RETURN CALCULATE ( [Avg Kp], FILTER ( ALL ( dim_date ), dim_date[Date] = d - 5 ) )
		formatString: 0.00
		displayFolder: Lagged Kp
		lineageTag: 72f27e76-b82a-4844-a556-9a894e1be120

	measure 'Avg Kp (lag 7d)' = VAR d = MAX ( dim_date[Date] ) RETURN CALCULATE ( [Avg Kp], FILTER ( ALL ( dim_date ), dim_date[Date] = d - 7 ) )
		formatString: 0.00
		displayFolder: Lagged Kp
		lineageTag: fdd8e8b7-2f13-4c91-84ce-402d6a4128e4

	measure 'Kp Coverage %' = DIVIDE ( COUNTROWS ( FILTER ( VALUES ( dim_date[Date] ), CALCULATE ( COUNT ( fact_environment[Kp Index] ) ) > 0 ) ), [Calendar Days] )
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: e59731d9-823e-4672-8da8-e7797f3bc8b7

	measure 'F10.7 Coverage %' = DIVIDE ( COUNTROWS ( FILTER ( VALUES ( dim_date[Date] ), CALCULATE ( COUNT ( fact_environment[F10.7 Flux (sfu)] ) ) > 0 ) ), [Calendar Days] )
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: 87520825-55bb-4677-bf83-ad0083830836

